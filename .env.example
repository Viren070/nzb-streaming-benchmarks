# NNTP providers. Numbered/named blocks are discovered automatically:
#   <PREFIX>_HOST / _PORT / _TLS / _USER / _PASS / _CONNS / _BACKUP
# NNTP is treated as the primary; every other prefix is an additional provider.

NNTP_HOST=news.example.com
NNTP_PORT=563
NNTP_TLS=1
NNTP_USER=your-username
NNTP_PASS=your-password
NNTP_CONNS=50

# Optional second provider
# NNTP2_HOST=news2.example.com
# NNTP2_PORT=563
# NNTP2_TLS=1
# NNTP2_USER=
# NNTP2_PASS=
# NNTP2_CONNS=20
# NNTP2_BACKUP=1
